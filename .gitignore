# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.pyright/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment variables and secrets (ADR-016 budget tracking, API keys)
.env
.env.local
*.key
*.pem

# Data (ADR-009: parquet files in data/ are gitignored — too large, often licensed)
data/raw/*
data/processed/*
data/cache/
*.parquet
*.csv
*.feather
!data/raw/.gitkeep
!data/processed/.gitkeep

# News history (ADR-025): narrow, intentional exception to ADR-009. A single
# compact parquet (headline metadata + Layer 1 sentiment, NO article body) is
# committed so the scheduled job can accumulate months of history across
# ephemeral containers. Small + low licensing risk. Must come after *.parquet.
!data/news_history/
!data/news_history/*.parquet

# Category rotation history (Fase 6, same rationale as ADR-025): a small daily
# snapshot of crypto category market caps/moves, committed so the scheduled job
# accumulates the rotation history that feeds the future probabilistic layer.
!data/category_history/
!data/category_history/*.parquet

# Equity sector rotation history (Fase 8, same rationale as ADR-025): small daily
# snapshot of sector/theme ETF momentum, committed so the scheduled job builds
# the equity rotation history.
!data/sector_history/
!data/sector_history/*.parquet

# Macro climate history (Fase 8, same rationale as ADR-025): small daily snapshot
# of FRED macro levels, committed so the scheduled job builds the macro history.
!data/macro_history/
!data/macro_history/*.parquet

# Paper trading state (Fase 6, ADR-029): committed so the live-shadow track
# record — the deliverable of the phase — survives ephemeral cron containers.
# Small JSON state + compact parquet audit trails; resets archive, never delete.
!data/paper/
!data/paper/**

# AI model caches (ADR-016 Layer 1: HuggingFace, sentence-transformers)
# Anchored to repo root so it ignores downloaded model weights only, not the
# src/models/ source package.
.cache/
.huggingface/
/models/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# uv
.uv-cache/

# OS
Thumbs.db
